# ============================================================================
# Azuria at Home — Environment & Credentials Template
# Copy this file to .env (which is Git-ignored) and fill in your local values.
# ============================================================================

# --- Tailscale Mesh Network ---
AK_SERVER_IP=100.64.0.10
AK_OWNER_IP=100.64.0.1

# --- VirtualBox Guest SSH Administration ---
AK_SSH_HOST=127.0.0.1
AK_SSH_PORT=22222
AK_SSH_USER=root
AK_SSH_KEY_PATH=private/vm_ed25519
AK_SSH_KNOWN_HOSTS=private/known_hosts
AK_SSH_KEY_PASSPHRASE=""
AK_VM_ROOT_PASSWORD=change-me-vm-root-password

# --- Astral Control Local Web Dashboard (http://127.0.0.1:8765) ---
AK_DASHBOARD_URL=http://127.0.0.1:8765
AK_DASHBOARD_USER=admin
AK_DASHBOARD_PASSWORD=change-me-dashboard-password

# --- Game Accounts (FFMember / FFAccount) ---
AK_GAME_GMADMIN_USER=gmadmin
AK_GAME_GMADMIN_PASSWORD=change-me-gmadmin-password

AK_GAME_PLAYERONE_USER=playerone
AK_GAME_PLAYERONE_PASSWORD=change-me-playerone-password
AK_GAME_PLAYERONE_CHARACTER=Zrymund

AK_GAME_PLAYERTWO_USER=playertwo
AK_GAME_PLAYERTWO_PASSWORD=change-me-playertwo-password
