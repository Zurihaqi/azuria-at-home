flush table inet ak_guard
table inet ak_guard {
    # Replace 100.64.0.1 with your Windows host / player Tailscale IPv4 address(es).
    set players_v4 { type ipv4_addr; elements = { 100.64.0.1 }; }
    set admins_v4 { type ipv4_addr; elements = { 100.64.0.1 }; }
    # LoginServer config + WorldServer/ZoneServer external ports in the supplied DB.
    set game_ports { type inet_service; elements = { 6543, 5567, 10020 }; }
    chain input {
        type filter hook input priority 10; policy drop;
        iifname "lo" accept
        ct state established,related accept
        ct state invalid drop
        # Localhost-only VirtualBox NAT forwarding is the bootstrap admin path.
        iifname "enp0s3" ip saddr 10.0.2.2 tcp dport 22 accept
        iifname "enp0s3" udp sport 67 udp dport 68 accept
        udp dport 41641 accept
        iifname "tailscale0" ip saddr @admins_v4 tcp dport 22 accept
        iifname "tailscale0" ip saddr @players_v4 tcp dport @game_ports accept
        meta l4proto { icmp, ipv6-icmp } accept
    }
}
